rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function sameUser(uid) { return request.auth != null && request.auth.uid == uid; }
    function deleting(uid) { return sameUser(uid)
      && exists(/databases/$(database)/documents/accountDeletionJobs/$(uid)); }
    function owner(uid) { return sameUser(uid)
      && !exists(/databases/$(database)/documents/accountDeletionJobs/$(uid)); }
    function natural(value) { return value is int && value >= 0 && value <= 2147483647; }
    function nonempty(value, limit) { return value is string && value.size() > 0 && value.size() <= limit; }
