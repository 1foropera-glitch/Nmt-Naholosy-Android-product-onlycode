        'v1_dbe45954a0c8e52175386e7a332ed53e14ee46866226a80aa1040fe5a8da5488',
        'v1_dcfb0860718ee4945349e00fd0ab9a34aa754f9cc1b6ba86e9357ba85bade91f',
        'v1_dfa2acc63bbaafafce65b9aca60e03f607e0ca56f5ce3ab9725661166462e223',
        'v1_e0d5002bc11844955d56a4542aded4d5bbd9ee5e6063cfb1265c8218100a008a',
        'v1_e19eed5b356ce50fb5893c804a365b02ebd02431a6e52c339eb9295755c6ba0a',
        'v1_e1f89c94c53112815ece18b4608775734352d55fe496759cb31ddf158a8e6d1e',
        'v1_e6ae018f46459106f47ceedbf4bdef2d514d0445301a622e2acc7a309811d79e',
        'v1_e6ea61fe1031182987981a9cdbc128596979f289358d90e211b45adeab663ba4',
        'v1_e6f1402e36a114fce6c3e644df41b918136673c7bf6137ea5cd59945b7d7692e',
        'v1_e8101fe76715db5af9b1f5e459bff2a8a095c68665a380a0ceac7792b3044253',
        'v1_e9770edc208b6a7170d05b75900bb562ef37f9c42ade4150910cd514b5cb1931',
        'v1_ea4c1dc7f96b61c2c0c12f34b4860e36cc5d3e95728324dcad97b5b146b460a6',
        'v1_eb0800083eb6aafc02464459465d409e793a7668e1fc73f7cac8faf9cb38282c',
        'v1_ecd1097ab992cae424e274f5a98dcffb7b749f4e9a0efcc03eaa4a05a1b2f3f5',
        'v1_ef2cdb34fa4c2c53e506128db5f12e16273488e4baf2de3846d875d08705c084',
        'v1_effd6d3c8bb75d0ea95325d1e7f481f001d362ac3c88845f01518d3a10f9b887',
        'v1_f0d690e8182f50e2be1d197fa6bb0f7f6e717d2e8632fac86083ad006dce6c6b',
        'v1_f1add779d00b6c0eed40159643feb9db2360a012043bf6ed92f7978fa964f199',
        'v1_f1cdf442aa0327c8041df221ec5d915827446c2780d34da18369eab52e5a0969',
        'v1_f3e7719b33f3dec95154494de79eb213dd483208e8e93f1fd77564da1726fb5b',
        'v1_f7620b1a680cf4d8b3a15455d82089c76a71b37f4c760367c1812d7c677a2987',
        'v1_f970ad99236b6b36ca4dac295f1c9a12572e03257630e255b521743672284555',
        'v1_fa8431286a0e89f1b2190293d04124f986e27b3299c3a6f9b0d5f7eae9147ac6',
        'v1_fb4a3420f49ba3a62d1aa5c7cfc83e8489f384064d3c37a6b91800931c06e293',
        'v1_fdc1778c220a7b69d599d912c1297e2e0282fb69490b37494f00ef6105090e16',
        'v1_fe1a2883092f5522f832221c2254b10b2be70fa6575f8dea3390b383f1f5e368',
        'v1_fed25a65a2ac538bec6170142649ef5d24d806f2dda1d05189f0b83bcd36e303'
      ];
    }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function validProfile(data) {
      return data.keys().hasOnly(['schemaVersion', 'generation', 'version', 'migrationCompleted', 'lastResetId', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['schemaVersion', 'generation', 'version', 'migrationCompleted', 'lastResetId', 'createdAt', 'updatedAt'])
        && data.schemaVersion == 2 && natural(data.generation) && natural(data.version)
        && data.migrationCompleted is bool && data.lastResetId is string && data.lastResetId.size() <= 128
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }
    function currentEpoch(uid, epoch) {
      return get(userPath(uid)).data.schemaVersion == 2
        && epoch == string(get(userPath(uid)).data.generation);
    }
    function validProgress(data, key) {
      return catalogKey(key)
        && data.keys().hasOnly(['schemaVersion', 'wordKey', 'box', 'status', 'dueAt', 'correctCount', 'wrongCount', 'lapseCount', 'lastReviewedAt', 'updatedAt', 'revision', 'deviceId', 'counters', 'counterWriter'])
        && data.keys().hasAll(['schemaVersion', 'wordKey', 'box', 'status', 'dueAt', 'correctCount', 'wrongCount', 'lapseCount', 'lastReviewedAt', 'updatedAt', 'revision', 'deviceId', 'counters'])
        && data.schemaVersion == 2 && data.wordKey == key
        && data.box is int && data.box >= 1 && data.box <= 7
        && ((data.status == 'learning' && data.dueAt is timestamp)
          || (data.status == 'learned' && data.box == 7 && data.dueAt == null))
        && natural(data.correctCount) && natural(data.wrongCount) && natural(data.lapseCount)
        && data.lastReviewedAt is timestamp && data.updatedAt is timestamp
        && natural(data.revision) && nonempty(data.deviceId, 128)
        && data.counters is map && data.counters.size() <= 512
        && data.counterWriter is string && data.counterWriter.matches('^[a-zA-Z0-9_-]{1,128}$');
    }
    function validCounter(c) {
      return c is map && c.keys().hasOnly(['correct', 'wrong', 'lapses'])
        && natural(c.correct) && natural(c.wrong) && natural(c.lapses);
    }
    function counterDelta(data, old) {
      let zero = {'correct': 0, 'wrong': 0, 'lapses': 0};
      let before = old.get('counters', {});
      let key = data.counterWriter;
      let a = before.get(key, zero);
      let b = data.counters.get(key, zero);
      return data.counters.diff(before).affectedKeys().hasOnly([key])
        && data.counters.keys().hasAll(before.keys())
        && validCounter(a) && validCounter(b)
        && b.correct >= a.correct && b.wrong >= a.wrong && b.lapses >= a.lapses
        && data.correctCount == old.get('correctCount', 0) + b.correct - a.correct
        && data.wrongCount == old.get('wrongCount', 0) + b.wrong - a.wrong
        && data.lapseCount == old.get('lapseCount', 0) + b.lapses - a.lapses;
    }
    function versionedProgress(uid, epoch) {
      return owner(uid) && currentEpoch(uid, epoch)
        && getAfter(userPath(uid)).data.generation == get(userPath(uid)).data.generation
        && getAfter(userPath(uid)).data.version == get(userPath(uid)).data.version + 1;
    }
    match /users/{uid} {
      allow read: if sameUser(uid);
      allow create: if owner(uid) && validProfile(request.resource.data)
        && request.resource.data.generation == 0 && request.resource.data.version == 0;
      allow update: if owner(uid) && validProfile(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && ((resource.data.schemaVersion == 1 && request.resource.data.generation == 0 && request.resource.data.version == 0)
          || (resource.data.schemaVersion == 2
            && request.resource.data.generation >= resource.data.generation
            && request.resource.data.generation <= resource.data.generation + 1
            && request.resource.data.version >= resource.data.version
            && request.resource.data.version <= resource.data.version + 1
            && (!resource.data.migrationCompleted || request.resource.data.migrationCompleted)
            && (request.resource.data.generation == resource.data.generation
              || (request.resource.data.version == resource.data.version + 1
                && nonempty(request.resource.data.lastResetId, 128)
                && request.resource.data.lastResetId != resource.data.lastResetId
                && getAfter(/databases/$(database)/documents/users/$(uid)/resetRequests/$(request.resource.data.lastResetId)).data.generation == request.resource.data.generation))));
      allow delete: if deleting(uid);
      // Legacy state is readable for one-time migration, but old clients cannot resurrect it.
      match /wordProgress/{key} { allow read: if owner(uid); allow write: if false; }
      match /epochs/{epoch}/wordProgress/{key} {
        allow read: if owner(uid) && currentEpoch(uid, epoch);
        allow create: if versionedProgress(uid, epoch) && validProgress(request.resource.data, key)
          && counterDelta(request.resource.data, {});
        allow update: if versionedProgress(uid, epoch) && validProgress(request.resource.data, key)
          && counterDelta(request.resource.data, resource.data);
      }
      match /entitlements/{id} { allow read: if owner(uid); allow write: if false; }
      match /resetRequests/{requestId} {
        allow read: if owner(uid);
        allow create: if owner(uid)
          && request.resource.data.keys().hasOnly(['generation', 'createdAt'])
          && request.resource.data.createdAt == request.time
          && natural(request.resource.data.generation)
          && getAfter(userPath(uid)).data.generation == get(userPath(uid)).data.generation + 1
          && request.resource.data.generation == getAfter(userPath(uid)).data.generation
          && getAfter(userPath(uid)).data.lastResetId == requestId;
        allow update, delete: if false;
      }
      // The deletion fence blocks every create/update, including stale devices. Only cleanup remains.
      match /{document=**} {
        allow read, delete: if deleting(uid);
      }
    }
    match /accountDeletionJobs/{uid} {
      allow read: if sameUser(uid);
      allow create: if sameUser(uid)
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.auth_time >= request.time.toMillis() / 1000 - 300
        && request.resource.data.keys().hasOnly(['createdAt', 'generation'])
        && request.resource.data.createdAt == request.time
        && natural(request.resource.data.generation)
        && ((!exists(userPath(uid)) && request.resource.data.generation == 0)
          || request.resource.data.generation == get(userPath(uid)).data.generation);
      // Admin cleanup only after Auth deletion is confirmed and old ID tokens have expired.
      allow update, delete: if false;
    }
    // Purchase tokens and entitlement mutations are accessible only through the Admin SDK.
    match /{document=**} { allow read, write: if false; }
  }
}
